# VANTAGE — copy to backend/.env and fill in. NEVER commit backend/.env.

# Required. The service refuses to start without it — it holds the coaching
# layer and is reachable from the internet when Funnelled.
VANTAGE_PIN=

# Required for coaching. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional. Without these, signals render as unavailable rather than as zero.
# Same values NEURO uses.
NOVA_BRIDGE_URL=
NOVA_BRIDGE_SECRET=

# Optional. Without these the radar's people half, and "log to NEURO" on a
# finding, report as unavailable rather than as nothing to see.
NEURO_URL=http://127.0.0.1:3001
NEURO_API_TOKEN=
# Only needed for vault reads, which have their own gate in NEURO.
NEURO_VAULT_API_KEY=

PORT=3006
# VANTAGE_DB_PATH=./data/vantage.db
